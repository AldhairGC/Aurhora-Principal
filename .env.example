# ─────────────────────────────────────────────────────────────
# Email transaccional — Brevo (https://brevo.com)
# El formulario de contacto envía correos vía la API REST de Brevo.
# El dominio del remitente debe estar autenticado en Brevo.
# ─────────────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=contacto@aurhora.agency
BREVO_ADMIN_EMAIL=contacto@aurhora.agency
# Opcional: ID de la lista de Brevo donde se agregan los leads del sitio.
# Brevo → Contactos → Listas (el número que aparece en la URL/lista).
BREVO_CONTACT_LIST_ID=
# Atribución de leads: el formulario envía UTM, gclid, página de entrada y plan.
# Para guardarlos como datos del contacto, crea en Brevo → Contactos → Configuración
# → Atributos de contacto (tipo texto): UTM_SOURCE, UTM_MEDIUM, UTM_CAMPAIGN,
# UTM_CONTENT, UTM_TERM, GCLID, FBCLID, LANDING_PAGE, REFERRER, PAGINA_FORMULARIO,
# UTM_SOURCE_FIRST, UTM_CAMPAIGN_FIRST, PLAN. Aunque no existan, la atribución
# llega igual en la descripción del deal y en el correo al equipo.

# ─────────────────────────────────────────────────────────────
# Google Search Console
# Código de la meta etiqueta de verificación (solo el valor de content="...").
# Si se deja vacío, no se emite la etiqueta.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GSC_VERIFICATION=

# ─────────────────────────────────────────────────────────────
# WhatsApp Business — botón flotante de contacto
# Número en formato internacional, solo dígitos (sin "+", espacios ni guiones).
# Ejemplo México: 52 + 10 dígitos → 525512345678
# Si se deja vacío, el botón de WhatsApp no se muestra.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─────────────────────────────────────────────────────────────
# Next.js
# ─────────────────────────────────────────────────────────────
# Valores: development | production | test
NODE_ENV=development

# Opcional: URLs por entorno
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
